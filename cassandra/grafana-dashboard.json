{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Cluster State & Connectivity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "up{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"}",
          "legendFormat": "{{pod_name}} ({{rack}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Node Status (Port 9000)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          },
          "unit": "nodes"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "sum(up{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"})",
          "legendFormat": "Active Cluster Nodes",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Healthy Pod Count",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "time() - process_start_time_seconds{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"}",
          "legendFormat": "{{pod_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Memory & CPU Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity"
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "process_resident_memory_bytes{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"}",
          "legendFormat": "RSS: {{pod_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "process_virtual_memory_bytes{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"}",
          "legendFormat": "VIRT: {{pod_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Process Memory Consumption",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"cass-operator\", container=\"cassandra\"}[$__rate_interval])",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Cassandra CPU Utilization (Cores)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Operating System & File Limits",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line" }
        }
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "process_open_fds{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"}",
          "legendFormat": "Open FDs: {{pod_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "process_max_fds{namespace=\"cass-operator\", job=\"lab-cluster-dc1-all-pods-service\"}",
          "legendFormat": "Max Limit: {{pod_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "File Descriptors (Open vs Max)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cassandra", "k3d", "cass-operator"],
  "time": { "from": "now-15m", "to": "now" },
